# Configuração de produção. Copiar para deploy/.env (que nunca vai para o Git) e preencher.
# O servidor recusa-se a arrancar se faltar algo essencial (ver os registos: docker compose logs app).
# Gerar segredos: openssl rand -base64 48

# --- Servidor ---
# Domínio público, já a apontar (registo A) para o IP deste servidor.
DOMAIN=camps.ao
# E-mail para os avisos do Let's Encrypt (certificado HTTPS).
ACME_EMAIL=tecnico@camps.ao
APP_URL=https://camps.ao
# Réplicas da aplicação: uma por vCPU do servidor. Memória máxima de cada uma.
APP_REPLICAS=2
APP_MEMORY=1g
# Base de dados e Redis deste servidor (serviços db e redis). Para um Postgres gerido, apagar
# "local-db" e preencher DATABASE_URL (com ?sslmode=require se o fornecedor o pedir).
COMPOSE_PROFILES=local-db
POSTGRES_PASSWORD=
# DATABASE_URL=postgres://utilizador:senha@host:5432/camps?sslmode=require
# Ligações por réplica ao Postgres. Réplicas × isto tem de ficar abaixo de max_connections (100).
DATABASE_POOL_MAX=10
BACKUP_KEEP_DAYS=14
BACKUP_HOUR=3

# --- Trabalho de fundo (pagamentos pendentes, reembolsos, e-mails, rankings) ---
JOBS_INTERVAL_SECONDS=30

# --- E-mail (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=Camps <nao-responder@camps.ao>
EMAIL_REPLY_TO=

# --- Pagamentos ---
PROXYPAY_API_URL=https://api.proxypay.co.ao
PROXYPAY_TOKEN=
PROXYPAY_POS_ID=
PAYPAL_API_URL=https://api-m.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_CURRENCY=USD
PAYPAL_EXCHANGE_RATE=

# --- Faturação ---
PLATFORM_FEE_PER_ATHLETE_KZ=500
PLATFORM_ADMIN_EMAILS=
FEDERATION_BASIC_KZ=150000
FEDERATION_PREMIUM_KZ=450000

# --- Mapa (entram na build: depois de mudar, reconstruir com --build) ---
# MapTiler: https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=CHAVE
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=

# --- Monitorização ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
