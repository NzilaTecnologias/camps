DATABASE_URL="postgres://postgres:postgres@127.0.0.1:51214/template1?sslmode=disable"
# Banco descartável que o `prisma migrate dev` usa para conferir as migrações.
SHADOW_DATABASE_URL="postgres://postgres:postgres@127.0.0.1:51215/template1?sslmode=disable"
# O Postgres local do `prisma dev` só aguenta uma ligação de cada vez. Em produção, remover
# (o tamanho do pool passa a ser o do driver) ou ajustar ao PgBouncer.
DATABASE_POOL_MAX="1"

# Endereço público da aplicação. Os provedores de pagamento devolvem o utilizador para aqui;
# o callback do Multicaixa Express só é pedido quando for https.
APP_URL="http://localhost:3000"

# Pagamentos de faz-de-conta para desenvolvimento. NUNCA ligar em produção: aprova inscrições sem cobrar.
PAYMENTS_SIMULATOR="1"

# Multicaixa Express via ProxyPay (https://developer.proxypay.co.ao/opg/v1/).
# Sandbox: https://api.sandbox.proxypay.co.ao · Produção: https://api.proxypay.co.ao
PROXYPAY_API_URL="https://api.sandbox.proxypay.co.ao"
PROXYPAY_TOKEN=""
PROXYPAY_POS_ID=""

# PayPal. Sandbox: https://api-m.sandbox.paypal.com · Produção: https://api-m.paypal.com
PAYPAL_API_URL="https://api-m.sandbox.paypal.com"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
# O PayPal não cobra em kwanzas: moeda da cobrança e quantos kwanzas vale 1 unidade dela.
PAYPAL_CURRENCY="USD"
PAYPAL_EXCHANGE_RATE=""

# --- Escala (ver docs/ARQUITETURA.md) ---
# Redis partilhado entre servidores: cache do placar, limites de pedidos e bloqueio do login.
# Vazio = memória de cada processo (serve para desenvolvimento e para um único servidor).
REDIS_URL=""
# Trabalho de fundo (pagamentos, reembolsos, rankings) de x em x segundos neste servidor.
# 0 ou vazio = desligado; nesse caso usar um agendador externo com /api/cron/jobs.
JOBS_INTERVAL_SECONDS="30"
# Segredo para o agendador externo chamar GET /api/cron/jobs (Authorization: Bearer <segredo>).
CRON_SECRET=""
# Mosaicos do mapa. Vazio = OpenStreetMap (só para pouco tráfego).
NEXT_PUBLIC_MAP_TILE_URL=""
NEXT_PUBLIC_MAP_ATTRIBUTION=""
