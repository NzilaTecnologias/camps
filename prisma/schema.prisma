generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // Índices trigram para as pesquisas "contém" não percorrerem as tabelas inteiras.
  extensions = [pg_trgm]
}

enum Gender {
  MALE
  FEMALE
}

enum OrganizerRole {
  OWNER
  ADMIN
  STAFF
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum RegistrationStatus {
  INCOMPLETE
  PAID
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentProvider {
  MULTICAIXA_EXPRESS
  PAYPAL
  /// Só para desenvolvimento: aprova ou recusa à mão, sem cobrar ninguém.
  SIMULATOR
}

enum FederationPlan {
  BASIC
  PREMIUM
}

enum MembershipStatus {
  PENDING
  ACTIVE
  CANCELLED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum BracketType {
  SINGLE_ELIMINATION
  ROUND_ROBIN
}

enum MatchStatus {
  PENDING
  READY
  BYE
  FINISHED
}

enum MatchSlot {
  RED
  BLUE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  /// Quando o utilizador abriu o link de confirmação enviado para o e-mail.
  emailVerifiedAt DateTime?
  /// Quando aceitou os Termos de utilização e a Política de privacidade (no registo).
  termsAcceptedAt DateTime?

  // Uma conta pode gerenciar vários perfis (ex.: pai inscrevendo os filhos).
  athletes      AthleteProfile[]
  memberships   OrganizerMember[]
  registrations Registration[]    @relation("RegisteredBy")
  sessions      Session[]
  refunds       Refund[]
  federations   FederationMember[]
  membershipRefunds MembershipRefund[]
  authTokens    AuthToken[]
}

enum AuthTokenKind {
  VERIFY_EMAIL
  PASSWORD_RESET
}

/// Links de uso único enviados por e-mail (confirmar o e-mail, nova palavra-passe).
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  kind      AuthTokenKind
  /// SHA-256 do token que vai no link; o token em si nunca é gravado.
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@index([expiresAt])
}

/// Fila de e-mails. Cada e-mail é gravado antes de ser enviado (na mesma transação do que o
/// originou, quando há uma) e a tarefa de fundo volta a tentar os que falharam.
model EmailOutbox {
  id            String    @id @default(cuid())
  to            String
  subject       String
  /// Apagados depois do envio quando `sensitive`: os links de acesso não ficam guardados.
  html          String
  text          String
  sensitive     Boolean   @default(false)
  attempts      Int       @default(0)
  /// Próxima tentativa; nulo quando já foi enviado ou se desistiu dele.
  nextAttemptAt DateTime? @default(now())
  lastError     String?
  /// Identificador do e-mail na Resend.
  providerId    String?
  sentAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([nextAttemptAt])
  @@index([createdAt])
}

model Session {
  id        String   @id @default(cuid())
  /// SHA-256 do token que fica no cookie; o token em si nunca é gravado.
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AthleteProfile {
  id        String   @id @default(cuid())
  userId    String
  firstName String
  lastName  String
  birthDate DateTime @db.Date
  gender    Gender
  country   String   @db.Char(2)
  belt      String?
  academyId String?
  createdAt DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id])
  academy       Academy?       @relation(fields: [academyId], references: [id])
  registrations Registration[]
  memberships   Membership[]

  @@index([userId])
  @@index([academyId])
  @@index([firstName(ops: raw("gin_trgm_ops"))], type: Gin, map: "AthleteProfile_firstName_trgm_idx")
  @@index([lastName(ops: raw("gin_trgm_ops"))], type: Gin, map: "AthleteProfile_lastName_trgm_idx")
}

model Academy {
  id            String  @id @default(cuid())
  name          String
  country       String  @db.Char(2)
  affiliationId String?

  /// Estatísticas públicas pré-calculadas pela tarefa de fundo (server/jobs.ts), para o
  /// ranking não ter de contar medalhas de todas as inscrições a cada visita.
  athleteCount Int  @default(0)
  gold         Int  @default(0)
  silver       Int  @default(0)
  bronze       Int  @default(0)
  /// Posição no ranking geral; nulo = sem atletas em eventos publicados.
  rank         Int?

  affiliation Affiliation?     @relation(fields: [affiliationId], references: [id])
  athletes    AthleteProfile[]
  federations FederationAcademy[]

  @@index([rank])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Academy_name_trgm_idx")
}

model Affiliation {
  id   String @id @default(cuid())
  name String @unique

  academies Academy[]
}

model Organizer {
  id   String @id @default(cuid())
  name String
  slug String @unique
  /// Conta para onde a Camps transfere o saldo das inscrições de cada evento.
  payoutHolder String?
  payoutIban   String?

  members     OrganizerMember[]
  events      Event[]
  federations FederationOrganizer[]
}

model OrganizerMember {
  organizerId String
  userId      String
  role        OrganizerRole @default(STAFF)

  organizer Organizer @relation(fields: [organizerId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@id([organizerId, userId])
}

model Event {
  id                   String      @id @default(cuid())
  organizerId          String
  slug                 String      @unique
  name                 String
  description          String?
  venue                String?
  city                 String?
  country              String      @db.Char(2)
  startsAt             DateTime
  endsAt               DateTime
  registrationOpensAt  DateTime
  registrationClosesAt DateTime
  status               EventStatus @default(DRAFT)
  currency             String      @default("AOA") @db.Char(3)
  /// Modalidade principal (lista em src/lib/sports.ts).
  sport                String      @default("Jiu-Jitsu")
  /// Ponto marcado pelo organizador no mapa; sem ele, o mapa usa o centro da cidade.
  latitude             Float?
  longitude            Float?
  capacity             Int?
  /// Desconto automático para quem se inscreve cedo: percentagem e último instante em que vale.
  earlyDiscountPercent Int?
  earlyDiscountEndsAt  DateTime?
  /// Inscrições pagas, pré-calculadas pela tarefa de fundo para ordenar por popularidade.
  paidRegistrations    Int         @default(0)
  /// Taxa da Camps por atleta confirmado, fixada quando o evento é criado (ver server/billing.ts).
  platformFeeCents     Int         @default(50000)
  createdAt            DateTime    @default(now())

  organizer     Organizer      @relation(fields: [organizerId], references: [id])
  divisions     Division[]
  coupons       Coupon[]
  registrations Registration[]
  mats          Mat[]
  payouts       Payout[]
  /// Federação sob a qual o evento decorre (conta para o ranking dela e pode exigir filiação).
  federationId         String?
  /// Só atletas com filiação individual ativa nessa federação se podem inscrever (plano Premium).
  requiresMembership   Boolean     @default(false)
  federation    Federation?    @relation(fields: [federationId], references: [id])

  @@index([status, startsAt])
  @@index([status, paidRegistrations])
  @@index([federationId, startsAt])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Event_name_trgm_idx")
  @@index([city(ops: raw("gin_trgm_ops"))], type: Gin, map: "Event_city_trgm_idx")
}

/// Categoria de competição: uma combinação de sexo, idade, faixa e peso.
model Division {
  id          String   @id @default(cuid())
  eventId     String
  name        String
  gender      Gender
  ageGroup    String
  minAge      Int?
  maxAge      Int?
  belt        String
  weightClass String
  /// Limite superior de peso; nulo = categoria sem limite (pesadíssimo / absoluto).
  maxWeightKg Decimal? @db.Decimal(5, 2)
  priceCents  Int
  capacity    Int?

  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations Registration[]
  bracket       Bracket?

  @@index([eventId])
}

model Coupon {
  id             String    @id @default(cuid())
  eventId        String
  /// Sempre em maiúsculas; o atleta pode escrevê-lo de qualquer maneira.
  code           String
  percentOff     Int?
  amountOffCents Int?
  /// Quantas inscrições pagas o podem usar; os usos contam-se nas inscrições.
  maxUses        Int?
  expiresAt      DateTime?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())

  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations Registration[]

  @@unique([eventId, code])
}

model Registration {
  id             String             @id @default(cuid())
  eventId        String
  divisionId     String
  athleteId      String
  registeredById String
  status         RegistrationStatus @default(INCOMPLETE)
  /// Preço final já com desconto, congelado no momento da inscrição.
  priceCents     Int
  /// Quanto foi descontado do preço da categoria (desconto antecipado + cupão).
  discountCents  Int                @default(0)
  /// Primeira vez que a inscrição ficou confirmada. Conta para a taxa da Camps mesmo que
  /// o atleta desista ou seja reembolsado depois (como os créditos do Smoothcomp).
  confirmedAt    DateTime?
  couponId       String?
  seed           Int?
  createdAt      DateTime           @default(now())

  event        Event          @relation(fields: [eventId], references: [id])
  division     Division       @relation(fields: [divisionId], references: [id])
  athlete      AthleteProfile @relation(fields: [athleteId], references: [id])
  registeredBy User           @relation("RegisteredBy", fields: [registeredById], references: [id])
  coupon       Coupon?        @relation(fields: [couponId], references: [id])
  payments     Payment[]
  weighIn      WeighIn?
  placement    Placement?
  redMatches   Match[]        @relation("Red")
  blueMatches  Match[]        @relation("Blue")
  wonMatches   Match[]        @relation("Winner")

  @@unique([divisionId, athleteId])
  @@index([eventId, status])
  @@index([athleteId])
  @@index([couponId])
}

model Payment {
  id             String          @id @default(cuid())
  registrationId String
  provider       PaymentProvider
  /// Identificador da transação no provedor (transação GPO, ordem PayPal).
  providerRef    String?
  /// Valor da inscrição, na moeda do evento.
  amountCents    Int
  /// O que foi de facto cobrado no provedor: o PayPal não aceita AOA e cobra noutra moeda.
  chargeCurrency    String       @db.Char(3)
  chargeAmountCents Int
  status         PaymentStatus   @default(PENDING)
  failureReason  String?
  createdAt      DateTime        @default(now())
  settledAt      DateTime?

  registration Registration @relation(fields: [registrationId], references: [id])
  refund       Refund?

  @@unique([provider, providerRef])
  @@index([registrationId])
  @@index([status, createdAt])
}

/// Transferência do saldo de um evento para a conta do organizador, registada por um administrador.
model Payout {
  id           String   @id @default(cuid())
  /// Repasse do saldo de um evento (inscrições) ou de uma federação (quotas de filiação).
  eventId      String?
  federationId String?
  amountCents  Int
  /// Referência da transferência bancária (número de operação).
  reference   String
  paidAt      DateTime @default(now())
  recordedBy  String

  event      Event?      @relation(fields: [eventId], references: [id])
  federation Federation? @relation(fields: [federationId], references: [id])

  @@index([eventId])
  @@index([federationId])
}

/// Devolução total de um pagamento, pedida pelo organizador.
model Refund {
  id            String       @id @default(cuid())
  paymentId     String       @unique
  status        RefundStatus @default(PENDING)
  /// Devolvido fora da plataforma (numerário, transferência): fica só registado.
  manual        Boolean      @default(false)
  /// Identificador da devolução no provedor.
  providerRef   String?
  reason        String
  failureReason String?
  requestedById String
  createdAt     DateTime     @default(now())
  settledAt     DateTime?

  payment     Payment @relation(fields: [paymentId], references: [id])
  requestedBy User    @relation(fields: [requestedById], references: [id])

  @@index([status])
}

model WeighIn {
  id             String   @id @default(cuid())
  registrationId String   @unique
  weightKg       Decimal  @db.Decimal(5, 2)
  passed         Boolean
  weighedAt      DateTime @default(now())

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
}

/// Área de luta.
model Mat {
  id        String @id @default(cuid())
  eventId   String
  name      String
  sortOrder Int    @default(0)
  /// Luta que está agora no placar desta área; é o que o ecrã de TV e a sobreposição mostram.
  currentMatchId String? @unique
  /// Endereço da transmissão (YouTube ou Facebook) desta área.
  streamUrl String?
  isLive    Boolean @default(false)

  event        Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  matches      Match[] @relation("MatMatches")
  currentMatch Match?  @relation("CurrentMatch", fields: [currentMatchId], references: [id], onDelete: SetNull)

  @@unique([eventId, name])
}

model Bracket {
  id         String      @id @default(cuid())
  divisionId String      @unique
  type       BracketType
  published  Boolean     @default(false)
  createdAt  DateTime    @default(now())

  division   Division    @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  matches    Match[]
  placements Placement[]
}

model Match {
  id        String      @id @default(cuid())
  bracketId String
  /// Chave estável gerada pelo motor de chaves, ex.: "R1-M3", "BRONZE".
  key       String
  round     Int
  position  Int
  redId     String?
  blueId    String?
  winnerId  String?
  status    MatchStatus @default(PENDING)
  method    String?
  redScore  Int         @default(0)
  blueScore Int         @default(0)
  redAdvantages  Int    @default(0)
  blueAdvantages Int    @default(0)
  redPenalties   Int    @default(0)
  bluePenalties  Int    @default(0)

  /// Cronómetro do placar. Parado: `clockRemainingMs` é o tempo que falta.
  /// A correr: falta `clockRemainingMs` menos o que passou desde `clockStartedAt`.
  durationSeconds  Int       @default(300)
  clockRemainingMs Int?
  clockStartedAt   DateTime?

  nextKey       String?
  nextSlot      MatchSlot?
  loserNextKey  String?
  loserNextSlot MatchSlot?

  matId       String?
  /// Ordem da luta dentro da área.
  sequence    Int?
  scheduledAt DateTime?
  finishedAt  DateTime?

  bracket Bracket       @relation(fields: [bracketId], references: [id], onDelete: Cascade)
  red     Registration? @relation("Red", fields: [redId], references: [id])
  blue    Registration? @relation("Blue", fields: [blueId], references: [id])
  winner  Registration? @relation("Winner", fields: [winnerId], references: [id])
  mat     Mat?          @relation("MatMatches", fields: [matId], references: [id])
  currentOnMat Mat?     @relation("CurrentMatch")

  @@unique([bracketId, key])
  @@index([matId, sequence])
  @@index([redId])
  @@index([blueId])
  @@index([winnerId])
}

model Placement {
  id             String @id @default(cuid())
  bracketId      String
  registrationId String @unique
  place          Int

  bracket      Bracket      @relation(fields: [bracketId], references: [id], onDelete: Cascade)
  registration Registration @relation(fields: [registrationId], references: [id])

  @@index([bracketId, place])
}

/// Federação, liga ou associação com página própria (/f/<slug>), à semelhança das plataformas de
/// federação do Smoothcomp. Funciona com uma assinatura anual (plano) ativada pela Camps.
model Federation {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  sport       String
  description String?
  /// Cor da marca (#rrggbb) usada no cabeçalho da página pública.
  color       String          @default("#d21f2b")
  plan        FederationPlan?
  /// Até quando o plano está pago; sem data ou no passado, a federação está inativa.
  planExpiresAt DateTime?
  payoutHolder String?
  payoutIban   String?
  createdAt   DateTime        @default(now())

  members     FederationMember[]
  organizers  FederationOrganizer[]
  academies   FederationAcademy[]
  plans       MembershipPlan[]
  memberships Membership[]
  posts       FederationPost[]
  events      Event[]
  payouts     Payout[]
}

model FederationMember {
  federationId String
  userId       String
  createdAt    DateTime @default(now())

  federation Federation @relation(fields: [federationId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id])

  @@id([federationId, userId])
  @@index([userId])
}

/// Organização autorizada pela federação a pôr os seus eventos sob ela.
model FederationOrganizer {
  federationId String
  organizerId  String
  createdAt    DateTime @default(now())

  federation Federation @relation(fields: [federationId], references: [id], onDelete: Cascade)
  organizer  Organizer  @relation(fields: [organizerId], references: [id])

  @@id([federationId, organizerId])
  @@index([organizerId])
}

/// Filiação de uma academia (plano Básico e Premium), gerida pela federação.
model FederationAcademy {
  federationId String
  academyId    String
  validUntil   DateTime
  createdAt    DateTime @default(now())

  federation Federation @relation(fields: [federationId], references: [id], onDelete: Cascade)
  academy    Academy    @relation(fields: [academyId], references: [id])

  @@id([federationId, academyId])
  @@index([academyId])
}

/// Plano de filiação individual (plano Premium): preço e duração definidos pela federação.
model MembershipPlan {
  id           String   @id @default(cuid())
  federationId String
  name         String
  priceCents   Int
  months       Int      @default(12)
  /// Idade máxima no ano da filiação (ex.: plano juvenil até 17); nulo = qualquer idade.
  maxAge       Int?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  federation  Federation   @relation(fields: [federationId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@index([federationId])
}

/// Filiação individual de um atleta numa federação.
model Membership {
  id           String           @id @default(cuid())
  federationId String
  planId       String
  athleteId    String
  boughtById   String
  status       MembershipStatus @default(PENDING)
  priceCents   Int
  validFrom    DateTime?
  validUntil   DateTime?
  createdAt    DateTime         @default(now())

  federation Federation          @relation(fields: [federationId], references: [id], onDelete: Cascade)
  plan       MembershipPlan      @relation(fields: [planId], references: [id])
  athlete    AthleteProfile      @relation(fields: [athleteId], references: [id])
  payments   MembershipPayment[]

  @@index([federationId, status])
  @@index([athleteId, federationId])
}

/// Pagamento de uma quota de filiação: mesmos provedores e regras dos pagamentos de inscrições.
model MembershipPayment {
  id                String          @id @default(cuid())
  membershipId      String
  provider          PaymentProvider
  providerRef       String?
  amountCents       Int
  chargeCurrency    String          @db.Char(3)
  chargeAmountCents Int
  status            PaymentStatus   @default(PENDING)
  failureReason     String?
  createdAt         DateTime        @default(now())
  settledAt         DateTime?

  membership Membership        @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  refund     MembershipRefund?

  @@unique([provider, providerRef])
  @@index([membershipId])
  @@index([status, createdAt])
}

/** Devolução total de uma quota de filiação, pedida pela federação. Mesmas regras de Refund. */
model MembershipRefund {
  id            String       @id @default(cuid())
  paymentId     String       @unique
  status        RefundStatus @default(PENDING)
  /// Devolvido fora da plataforma (numerário, transferência): fica só registado.
  manual        Boolean      @default(false)
  providerRef   String?
  reason        String
  failureReason String?
  requestedById String
  createdAt     DateTime     @default(now())
  settledAt     DateTime?

  payment     MembershipPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  requestedBy User              @relation(fields: [requestedById], references: [id])

  @@index([status])
}

/// Notícia na página da federação (plano Premium).
model FederationPost {
  id           String   @id @default(cuid())
  federationId String
  title        String
  body         String
  publishedAt  DateTime @default(now())

  federation Federation @relation(fields: [federationId], references: [id], onDelete: Cascade)

  @@index([federationId, publishedAt])
}
